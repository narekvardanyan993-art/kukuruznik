    "plaque": {
      "hy": "Լենինի արձանը (1940–1991) · Լենինի հրապարակը 1970-ականների վերջին – 1980-ականներին · գեղարվեստական վերակառուցում արխիվային լուսանկարներից · շարժիչի փորձարկում",
      "ru": "Памятник Ленину (1940–1991) · площадь Ленина в конце 1970-х — 1980-х · художественная реконструкция по архивным фото · проверка движка",
      "en": "Lenin Monument (1940–1991) · Lenin Square in the late 1970s–1980s · artistic reconstruction after archive photos · engine check"
    },
    "panelTitle": {"hy": "Լենինի արձանը", "ru": "Памятник Ленину", "en": "Lenin Monument"},
    "welcome": {
      "hy": "Բարի գալուստ Լենինի արձանի մոտ",
      "ru": "Добро пожаловать к памятнику Ленину",
      "en": "Welcome to the Lenin Monument"
    }
  },
  "facts": {
    "sculptor": {
      "hy": "Արձանի հեղինակը քանդակագործ Սերգեյ Մերկուրովն է։",
      "ru": "Автор памятника — скульптор Сергей Меркуров.",
      "en": "The monument is by the sculptor Sergey Merkurov."
    },
    "opened": {
      "hy": "Արձանը բացվել է 1940 թվականի նոյեմբերի 24-ին՝ այժմյան Հանրապետության հրապարակում։",
      "ru": "Памятник открыт 24 ноября 1940 года на нынешней площади Республики.",
      "en": "The monument was unveiled on 24 November 1940 on what is now Republic Square."
    },
    "removed": {
      "hy": "Արձանը ապամոնտաժվել է 1991 թվականի ապրիլի 13-ին։",
      "ru": "Памятник снят 13 апреля 1991 года.",
      "en": "The monument was taken down on 13 April 1991."
    }
  },
