  "facts": {
    "sculptor": {
      "hy": "Արձանի հեղինակը քանդակագործ Սերգեյ Մերկուրովն է։",
      "ru": "Автор памятника — скульптор Сергей Меркуров.",
      "en": "The monument is by the sculptor Sergey Merkurov."
    },
    "opened": {
      "hy": "Արձանը բացվել է 1940 թվականի նոյեմբերի 24-ին՝ այժմյան Հանրապետության հրապարակում։",
      "ru": "Памятник открыт 24 ноября 1940 года на нынешней площади Республики.",
      "en": "The monument was unveiled on 24 November 1940 on what is now Republic Square."
    },
    "removed": {
      "hy": "Արձանը ապամոնտաժվել է 1991 թվականի ապրիլի 13-ին։",
      "ru": "Памятник снят 13 апреля 1991 года.",
      "en": "The monument was taken down on 13 April 1991."
    }
  },
